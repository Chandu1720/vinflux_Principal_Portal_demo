# VinFlux integration service — copy to your host's environment (Vercel → Settings → Environment Variables).
# Never commit real values. See server/README.md for each ERP.
VFX_API_KEY=change-me-long-random
# Standalone service only
VFX_ALLOWED_ORIGIN=https://your-vinflux-app.vercel.app
VFX_AGENT_KEY=change-me-agent-key
# Example: Odoo
VFX_ODOO_URL=https://yourcompany.odoo.com
VFX_ODOO_DB=yourcompany
VFX_ODOO_LOGIN=integration@yourcompany.com
VFX_ODOO_API_KEY=
